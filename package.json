    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^1.73.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "prettier": "^3.9.6",
    "sass": "^1.87.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
